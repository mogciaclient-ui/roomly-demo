# Set demo only for a local presentation environment. Unset/production uses Firebase production mode.
NEXT_PUBLIC_ROOMLY_MODE=production
NEXT_PUBLIC_ROOMLY_PUBLIC_URL=https://www.roomly-demo.app

# Firebase Web app configuration (public browser values)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Prefer Application Default Credentials on Firebase hosting.
# For other hosts, set the full service account JSON as one line. Never expose it with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=
