rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function staffData() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data; }
    function isTrial() { return signedIn() && request.auth.token.keys().hasAny(['trial']) && request.auth.token.trial == true; }
    function isStaff() { return signedIn() && staffData().active == true && (!isTrial() || staffData().expiresAt > request.time); }
    function isStaffFor(facilityId) { return isStaff() && (!isTrial() || request.auth.token.facilityId == facilityId); }
    match /staff/{staffId} { allow read: if signedIn() && request.auth.uid == staffId; allow write: if false; }
    match /facilities/{facilityId} {
      allow read, write: if isStaffFor(facilityId);
      match /info/{document} { allow read, write: if isStaffFor(facilityId); }
      match /rooms/{roomId} { allow read, write: if isStaffFor(facilityId); }
      match /threads/{threadId} {
        allow read, write: if isStaffFor(facilityId);
        match /messages/{messageId} { allow read, write: if isStaffFor(facilityId); }
      }
    }
    match /guestSessions/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /roomTokens/{token} { allow read, write: if false; }
    match /trialInvites/{invite} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
